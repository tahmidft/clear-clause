# Copy to .env and replace placeholders. Never commit .env.
#
# Google AI Studio → API key (server only; never put in the frontend)
GEMINI_API_KEY=your_gemini_api_key_here
# Google AI model id (default gemini-2.5-flash-lite; gemini-1.5-flash is retired)
GEMINI_MODEL=gemini-2.5-flash-lite

# Supabase → Project Settings → API: Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Same publishable key as frontend VITE_SUPABASE_ANON_KEY (used for JWT validation via Auth API)
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here
# Secret / service role key (Storage + privileged ops). Server only.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# Supabase → Project Settings → Database: URI (add ?sslmode=require if required)
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Comma-separated browser origins for production (e.g. https://your-app.vercel.app).
# Use * only for local open testing. If you list Vite explicitly, you can use either
# hostname; the API also mirrors localhost <-> 127.0.0.1 for the same port.
# Production example (comma-separated, no trailing slashes):
# CORS_ORIGINS=https://clearclause.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=*

# Optional — for scripts/render-sync-deploy.sh (do not commit real values):
# RENDER_API_KEY=rnd_...
# RENDER_DEPLOY_HOOK_URL=https://api.render.com/deploy/srv-...

# Optional — for scripts/supabase-auth-urls.sh (Account → Access Tokens; do not commit):
# SUPABASE_ACCESS_TOKEN=sbp_...

# development | production
APP_ENV=development

# Basic per-user endpoint limits
RATE_LIMIT_UPLOADS_PER_MINUTE=20
RATE_LIMIT_ANALYSIS_PER_MINUTE=30

# Data minimization controls
CONTRACT_TEXT_PERSISTENCE_ENABLED=true
CONTRACT_TEXT_RETENTION_DAYS=30
