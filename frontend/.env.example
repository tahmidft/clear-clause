# Copy to .env and replace placeholders. Never commit .env.
#
# Supabase → Project Settings → API (or Data API): Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Browser-safe key from Supabase → Project Settings → API: use "Publishable" / anon public key
# (often `eyJ…` JWT or `sb_publishable_…`). Same value as backend SUPABASE_ANON_KEY. Never the service_role / secret key.
VITE_SUPABASE_ANON_KEY=paste_publishable_or_anon_key_here
# FastAPI backend base URL (no trailing slash). Production: your deployed API URL
# In `npm run dev`, requests go to `/api/...` on the Vite origin and are proxied to this URL (avoids CORS).
VITE_API_URL=http://localhost:8000
# Set to false only if you need the browser to call the API host directly in dev (advanced).
# VITE_DEV_API_PROXY=false
