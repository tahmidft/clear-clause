# Copy to .env and replace placeholders. Never commit .env.
#
# Supabase → Project Settings → API (or Data API): Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable / anon public key (safe for the browser)
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here
# FastAPI backend base URL (no trailing slash). Production: your deployed API URL
VITE_API_URL=http://localhost:8000
